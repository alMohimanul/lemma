# MAVYN configuration

# LLM Provider API Keys
# At least one is required for LLM features (ask, summarize, etc.)

# Primary provider (recommended)
GROQ_API_KEY=your_groq_api_key_here

# Backup provider
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback provider
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local LLM via Ollama (no API key required)
# Install: https://ollama.com  |  Run: ollama serve
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Hugging Face token (optional, for faster downloads and higher rate limits)
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

# User display name (set automatically by `mavyn setup`, or override here)
# MAVYN_USER_NAME=Your Name

# Enable arXiv related-paper lookup during `ask` queries (disabled by default)
# MAVYN_ARXIV_RELATED=1
